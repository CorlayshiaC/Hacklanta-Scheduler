NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Absolute origin for share links, OG metadata, ICS feed URLs. Falls back to
# http://localhost:3000 in dev when unset.
NEXT_PUBLIC_SITE_URL=

# Server-only. Unset disables every AI feature; each one falls back to its manual path.
GEMINI_API_KEY=

# Server-only. Unset disables outbound notification email; notify() still writes in-app rows.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
