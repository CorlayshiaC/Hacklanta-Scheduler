# Required. Without these the app will not boot: every page renders the env error screen.
# Local values come from `supabase status`; production values from the Supabase dashboard,
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production, optional in dev. Absolute origin for share links, OG metadata, ICS feed
# URLs, and every link in an outbound email. Falls back to http://localhost:3000 when unset, which
# in production means emailing people links to their own laptop. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Server-only. Unset disables every AI feature; each one falls back to its manual path.
GEMINI_API_KEY=

# Server-only. Unset disables outbound notification email; notify() still writes in-app rows.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Server-only. Unset disables web push; sendPush() returns "not configured" instead of throwing.
# Generate the pair once with `npx web-push generate-vapid-keys` and keep them stable: rotating them
# invalidates every existing browser subscription, and every member has to re-enable push by hand.
# VAPID_SUBJECT must be a mailto: or https: URL identifying the sender (push services reject a bare
# string), e.g. mailto:progsu@gsu.edu
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
